+      code === 0x7f || // DEL
+      (code >= 0x80 && code <= 0x9f) || // C1
+      code === 0x2028 || // LINE SEPARATOR
+      code === 0x2029; // PARAGRAPH SEPARATOR
+    out += isLineBreakingOrControl ? " " : v[i];
