{
  // Lint all markdown except the trusted spec docs (see ignores).
  "globs": ["**/*.md", ".dev/**/*.md"],
  // Trusted spec docs are human-only and hook-protected; they are excluded so
  // style fixes can never mutate their content-hash (fix #4 / spec-drift).
  // They may still be formatted by hand; this only removes them from scope.
  // CONSTITUTION.md + ARCHITECTURE.md relocated under pharn/ (runtime-layout move); THREAT-MODEL.md +
  // LIMITS.md stay at root. pharn/floor/test-fixtures added alongside .dev/floor/test-fixtures (the
  // product fixtures relocated there; the variance fixture stayed under .dev/floor/test-fixtures).
  "ignores": [
    "node_modules",
    ".dev/floor/test-fixtures",
    "pharn/floor/test-fixtures",
    "pharn/CONSTITUTION.md",
    "pharn/ARCHITECTURE.md",
    "THREAT-MODEL.md",
    "LIMITS.md",
    // Generated capability catalog (byte-for-byte output of `npm run docs:generate`, guarded by
    // .dev/floor/check-capability-catalog.mjs). Excluded so linting can never rewrite committed bytes
    // and make the drift checker see false drift.
    "docs/capabilities",
    // Generated lessons index (byte-for-byte output of `npm run docs:generate`, guarded by
    // .dev/floor/check-lessons-index.mjs). Excluded for the same reason as the catalog: linting must never
    // rewrite committed bytes and make the drift checker see false drift. L11 sharpens it — these gates are
    // whole-repo, so one stale byte here would block EVERY later feature's /pharn-dev-verify.
    "docs/lessons-index.md",
    // The PRODUCT lessons index (byte-for-byte output of `node pharn/floor/gen-lessons-index.mjs .`,
    // guarded by pharn/floor/check-lessons-index.mjs). Load-bearing, and VERIFIED LIVE rather than
    // assumed: markdownlint-cli2 DOES descend into dot-directories, so `**/*.md` matches `.pharn/**`
    // even though `.pharn/` is gitignored (a mis-formatted probe there produced MD019/MD030). Without
    // this entry a `--fix` pass would rewrite the cache, and the drift checker would then report STALE
    // over damage the linter itself caused. Prettier deliberately has no matching `.prettierignore`
    // entry: probed the same way, `prettier --check .` does NOT traverse `.pharn/`, so there is no
    // trigger for one (P7 — no speculative additions).
    ".pharn/lessons-index.md",
    // Human-authored scratch under gitignored `.pharn/` — fix-request writeups, review notes. Excluded
    // for a DIFFERENT reason than the entry above: not "a --fix would damage a generated artifact" but
    // "these files are not the repo's markdown and were never meant to face its style gate". The
    // trigger is a real failure, not a hypothetical (P7): six such files RED'd `lint:md`, and through
    // it the capability-catalog `style:` test, which is L11's shape exactly — a whole-repo gate failing
    // on files unrelated to any increment blocks EVERY later feature's /pharn-dev-verify.
    // Deliberately `.pharn/fixes` and NOT a blanket `.pharn/`: the narrower scope is what was
    // authorized, and a blanket entry would silently also cover future load-bearing artifacts there.
    ".pharn/fixes",
    // The same scratch corpus, one stray copy of which sits at the `.pharn/` ROOT rather than under
    // `fixes/` (byte-identical to `.pharn/fixes/FABLE_REVIEW.md`, verified live). Named explicitly
    // instead of widening the entry above to a blanket `.pharn/`, so the exclusion stays an enumerated
    // list of known scratch rather than a standing waiver over a directory that also holds the
    // load-bearing product-index cache.
    ".pharn/FABLE_REVIEW.md",
  ],
  "config": {
    "default": true,
    // Long-form specs use wide lines and occasional inline HTML.
    "MD013": false,
    "MD033": false,
    // Keep a Changelog repeats "Added"/"Changed"/etc. under each release; allow
    // duplicate headings unless they are siblings under the same parent.
    "MD024": { "siblings_only": true },
    // GitHub issue/PR templates are fragments that open with "##" sections, not a
    // document title, so the first-line-h1 rule does not apply.
    "MD041": false,
  },
}
